const ELEMENT_METADATA: ElementResult[] = [
  { id: 'wood', label: 'WOOD', hanja: '木', name: '새벽의 민트빛', color: '#AEECEF', bg: 'transparent', keyword: '성장하고 뻗어나가는 달빛', desc: '어둠을 뚫고 피어나는 싱그러운 생명력의 빛깔입니다.' },
