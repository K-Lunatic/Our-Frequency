      bg: "bg-amber-50 border-amber-200/60",
      labelClass: "text-[10px] font-bold text-amber-500 tracking-widest",
      valClass: "text-lg font-extrabold text-amber-700",
    },
    {
      id: "core",
      label: "CORE",
      value: (elements?.distribution?.[0] || { name: "Unknown" }).name.split(
        " ",
